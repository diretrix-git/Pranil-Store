PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/dbname?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173

# Clerk (required by the backend)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Cloudinary (used for admin product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Upstash Redis REST catalog cache
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Optional: Gmail SMTP order notifications
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
GMAIL_FROM_NAME=Pranil Store
# New-order recipient and admin seed account address
ADMIN_EMAIL=admin@yourdomain.com

# Optional: Sentry error monitoring
SENTRY_DSN=

# Required only for optional seed and migration scripts; choose unique passwords
ADMIN_PASSWORD=
ADMIN_NAME=Admin
SEED_BUYER_EMAIL=buyer@example.com
SEED_BUYER_PASSWORD=
